# Gemini (가중치 추출). 없으면 키워드 기반 대체 분석으로 동작
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest

# Google Maps 서버용 — Routes API를 켠 키 (결제 계정 필요, 없으면 비워 두기)
GOOGLE_MAPS_SERVER_KEY=
# Google Maps 브라우저용 — Maps JavaScript API + Places API (New)를 켠 키 (결제 계정 필요, 리퍼러 제한 필수, 없으면 비워 두기)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google OAuth (Auth.js). 셋 다 있어야 로그인 버튼이 켜짐
# 캘린더 등록까지 쓰려면 Cloud 콘솔에서 Google Calendar API 사용 설정 + 동의 화면에 calendar.events 범위 추가 (README 참고)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Firebase (리포트 저장, Firestore). 로그인 3개 + 아래 3개가 모두 있어야 저장 기능이 켜짐
# 서비스 계정 JSON(프로젝트 설정 → 서비스 계정 → 새 비공개 키)의 project_id / client_email / private_key
# private_key는 한 줄로, 줄바꿈은 \n 그대로 두고 따옴표로 감싸기
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
